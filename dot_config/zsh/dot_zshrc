typeset -U fpath

ZSH_PLUGINS="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

if [ -d "$ZSH_PLUGINS/zsh-users/zsh-completions" ]; then
  fpath=("$ZSH_PLUGINS/zsh-users/zsh-completions/src" $fpath)
fi

ZSH_COMPDIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
[[ -d "$ZSH_COMPDIR" ]] || mkdir -p "$ZSH_COMPDIR"

(( $+commands[kubectl] )) && [[ ! -f "$ZSH_COMPDIR/_kubectl" ]] && kubectl completion zsh > "$ZSH_COMPDIR/_kubectl"
(( $+commands[helm] ))    && [[ ! -f "$ZSH_COMPDIR/_helm" ]]    && helm completion zsh > "$ZSH_COMPDIR/_helm"

fpath=("$ZSH_COMPDIR" $fpath)

source "$ZSH_PLUGINS/yous/vanilli.sh/vanilli.zsh"
source "$ZSH_PLUGINS/zsh-users/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh"
source "$ZSH_PLUGINS/zsh-users/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh"
source "$ZSH_PLUGINS/mafredri/zsh-async/async.plugin.zsh"
source "$ZSH_PLUGINS/sindresorhus/pure/pure.plugin.zsh"

autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"

setopt inc_append_history
setopt nohist_findnodups
setopt share_history

set -o emacs
bindkey -M emacs '^H' backward-kill-word

[ -f "$HOME/.aliases" ] && source "$HOME/.aliases"
[ -f "$ZDOTDIR/.zshrc.local" ] && source "$ZDOTDIR/.zshrc.local"

LOCAL_DIRCOLORS="${XDG_CONFIG_HOME:-$HOME/.config}/.dir_colors"
if [ -f "$LOCAL_DIRCOLORS" ]; then
    CACHE_DIRCOLORS="${XDG_CACHE_HOME:-$HOME/.cache}/dircolors.zsh"
    if [[ ! -f "$CACHE_DIRCOLORS" || "$LOCAL_DIRCOLORS" -nt "$CACHE_DIRCOLORS" ]]; then
        [[ -d "${CACHE_DIRCOLORS:h}" ]] || mkdir -p "${CACHE_DIRCOLORS:h}"
        dircolors -b "$LOCAL_DIRCOLORS" > "$CACHE_DIRCOLORS" 2>/dev/null
    fi
    source "$CACHE_DIRCOLORS"
fi
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Keep these commands at the end of the file

# FZF
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/fzf.zsh" ] && source "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/fzf.zsh"


# SDKMAN
if [ -d "$HOME/.local/bin/sdkman" ]; then
    export SDKMAN_DIR="$HOME/.local/bin/sdkman"
    [ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
fi

