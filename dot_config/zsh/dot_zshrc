typeset -U fpath

ZSH_PLUGINS="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

if [ -d "$ZSH_PLUGINS/zsh-users/zsh-completions" ]; then
  fpath=("$ZSH_PLUGINS/zsh-users/zsh-completions/src" $fpath)
fi

ZSH_COMPDIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
[[ -d "$ZSH_COMPDIR" ]] || mkdir -p "$ZSH_COMPDIR"

(( $+commands[kubectl] )) && [[ ! -s "$ZSH_COMPDIR/_kubectl" ]] && kubectl completion zsh > "$ZSH_COMPDIR/_kubectl"
(( $+commands[helm] ))    && [[ ! -s "$ZSH_COMPDIR/_helm" ]]    && helm completion zsh > "$ZSH_COMPDIR/_helm"
(( $+commands[rg] ))      && [[ ! -s "$ZSH_COMPDIR/_rg" ]]      && rg --generate complete-zsh > "$ZSH_COMPDIR/_rg"
(( $+commands[fnm] ))     && [[ ! -s "$ZSH_COMPDIR/_fnm" ]]     && fnm completions --shell zsh > "$ZSH_COMPDIR/_fnm"

(( $+commands[pipx] ))    && [[ -x "$HOME/.local/venv/bin/register-python-argcomplete" && ! -s "$ZSH_COMPDIR/_pipx" ]] \
    && "$HOME/.local/venv/bin/register-python-argcomplete" -s zsh pipx > "$ZSH_COMPDIR/_pipx"

[[ -f "$HOME/.local/opt/fd/autocomplete/_fd" && ! -s "$ZSH_COMPDIR/_fd" ]] \
    && ln -sf "$HOME/.local/opt/fd/autocomplete/_fd" "$ZSH_COMPDIR/_fd"

fpath=("$ZSH_COMPDIR" $fpath)

source "$ZSH_PLUGINS/yous/vanilli.sh/vanilli.zsh"
source "$ZSH_PLUGINS/zsh-users/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh"

# TODO use starship for now
#source "$ZSH_PLUGINS/mafredri/zsh-async/async.plugin.zsh"
#source "$ZSH_PLUGINS/sindresorhus/pure/pure.plugin.zsh"

autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"

# TODO haven't decided if i like this
#source "$ZSH_PLUGINS/Aloxaf/fzf-tab/fzf-tab.plugin.zsh"

setopt hist_ignore_space
setopt inc_append_history
setopt interactive_comments
setopt share_history

set -o emacs
bindkey -M emacs '^H' backward-kill-word

[ -f "$HOME/.aliases" ] && source "$HOME/.aliases"

LOCAL_DIRCOLORS="${XDG_CONFIG_HOME:-$HOME/.config}/.dir_colors"
if [ -f "$LOCAL_DIRCOLORS" ]; then
    CACHE_DIRCOLORS="${XDG_CACHE_HOME:-$HOME/.cache}/dircolors.zsh"
    if [[ ! -f "$CACHE_DIRCOLORS" || "$LOCAL_DIRCOLORS" -nt "$CACHE_DIRCOLORS" ]]; then
        [[ -d "${CACHE_DIRCOLORS:h}" ]] || mkdir -p "${CACHE_DIRCOLORS:h}"
        dircolors -b "$LOCAL_DIRCOLORS" > "$CACHE_DIRCOLORS" 2>/dev/null
    fi
    source "$CACHE_DIRCOLORS"
fi
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# FZF
source <(fzf --zsh)

# FNM
eval "$(fnm env --use-on-cd --shell zsh)"

# STARSHIP
eval "$(starship init zsh)"

# SDKMAN
if [ -d "$HOME/.local/opt/sdkman" ]; then
    export SDKMAN_DIR="$HOME/.local/opt/sdkman"
    [ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
fi

[ -f "${ZDOTDIR:-$HOME}/.zshrc.local" ] && source "${ZDOTDIR:-$HOME}/.zshrc.local"

# this should be sourced at the end of the file
source "$ZSH_PLUGINS/zsh-users/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh"
